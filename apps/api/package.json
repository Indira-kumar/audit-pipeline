{
  "name": "@smartaudit/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --import tsx src/worker.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "test": "node --import tsx --test --test-isolation=none src/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "5.2.1",
    "mongodb": "7.7.0"
  }
}
